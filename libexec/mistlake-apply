#!/usr/bin/env bash
# Apply Mistlake to DMS after `catdot select` or `catdot update`.
# Catdot never runs hooks, and DMS keeps its state in its own settings.json
# (outside any Profile). This script merges the Profile's shell preset into
# that file, keeping a backup, and leaves every other DMS setting untouched.
set -euo pipefail

theme_dir="$HOME/.config/DankMaterialShell/themes/mistlake"
settings="$HOME/.config/DankMaterialShell/settings.json"
backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/catos-niri-mistlake/settings-backups"

for f in "$theme_dir/theme.json" "$theme_dir/shell.json" "$settings"; do
    if [[ ! -f "$f" ]]; then
        echo "mistlake-apply: $f not found. Run: catdot select catos-niri-mistlake" >&2
        exit 1
    fi
done
if ! dms ipc call settings get currentThemeName >/dev/null 2>&1; then
    echo "mistlake-apply: DMS is not running; log in to the niri session first." >&2
    exit 1
fi

mkdir -p "$backup_dir"
stamp=$(date +%Y%m%d-%H%M%S)
cp -- "$settings" "$backup_dir/settings.json.$stamp"
# Keep the ten most recent backups.
ls -1t "$backup_dir"/settings.json.* 2>/dev/null | tail -n +11 | xargs -r rm --

echo "Applying Mistlake to DMS:"
python3 -I - "$settings" "$theme_dir" <<'EOF'
import json, os, sys, tempfile

settings_path, theme_dir = sys.argv[1], sys.argv[2]
with open(settings_path, encoding="utf-8") as f:
    settings = json.load(f)
with open(os.path.join(theme_dir, "shell.json"), encoding="utf-8") as f:
    preset = json.load(f)

changed = dict(preset.get("settings", {}))
changed["currentThemeCategory"] = "custom"
changed["currentThemeName"] = "custom"
changed["customThemeFile"] = os.path.join(theme_dir, "theme.json")
settings.update(changed)

bars = settings.setdefault("barConfigs", [])
bar = next((b for b in bars if b.get("id") == "default"), None)
if bar is None:
    print("  no bar with id 'default'; bar preset skipped")
else:
    bar.update(preset.get("bar", {}))

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(settings_path), prefix=".settings.")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(settings, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.replace(tmp, settings_path)
bar_note = "" if bar is None else f" and {len(preset.get('bar', {}))} bar fields"
print(f"  merged {len(changed)} settings{bar_note}")
EOF
echo "  backup: $backup_dir/settings.json.$stamp"

# matugen: config.toml is a catdot seed, so the Profile cannot update it after
# the first activation. Splice the managed mistlake.toml between markers so
# DMS's matugen run (which includes user templates) renders the Mistlake skins.
python3 -I - "$HOME/.config/matugen/config.toml" "$HOME/.config/matugen/mistlake.toml" <<'EOF'
import os, re, sys
config_path, block_path = sys.argv[1], sys.argv[2]
if not os.path.exists(block_path):
    print("  matugen: mistlake.toml missing, skipped")
    sys.exit(0)
block = open(block_path, encoding="utf-8").read().rstrip("\n")
begin = "# >>> mistlake (managed by mistlake-apply; edits here are replaced)"
end = "# <<< mistlake"
text = open(config_path, encoding="utf-8").read() if os.path.exists(config_path) else ""
section = f"{begin}\n{block}\n{end}\n"
pattern = re.compile(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", re.S)
text = pattern.sub(lambda _: section, text) if pattern.search(text) else text.rstrip("\n") + "\n\n" + section
open(config_path, "w", encoding="utf-8").write(text)
print("  matugen: Mistlake templates registered")
EOF

# fcitx5: frosted Catppuccin Sapphire skins (latte when light, mocha when dark,
# so fcitx5 follows the light/dark preference DMS sets) with horizontal
# candidates. Only these four keys are touched; fonts and every other
# classicui option stay yours. A running fcitx5 keeps classicui settings in
# memory and fcitx5-remote -r does not reload them, so set them over D-Bus
# (applied at once and saved to classicui.conf); edit the file only when
# fcitx5 is not running. The skins ask niri for blur, which fcitx5 only binds
# when it creates its surfaces, so restart fcitx5 when the skin changes.
classicui="$HOME/.config/fcitx5/conf/classicui.conf"
fcitx_ctl=(busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1)
old_skin=$("${fcitx_ctl[@]}" GetConfig s "fcitx://config/addon/classicui" 2>/dev/null \
    | grep -oE '"DarkTheme" s "[^"]*"' || true)
if "${fcitx_ctl[@]}" SetConfig sv "fcitx://config/addon/classicui" "a{sv}" 4 \
        "Theme" s "catppuccin-latte-sapphire-frost" \
        "DarkTheme" s "catppuccin-mocha-sapphire-frost" "UseDarkTheme" s "True" \
        "Vertical Candidate List" s "False" >/dev/null 2>&1; then
    if [[ "$old_skin" != *'"catppuccin-mocha-sapphire-frost"'* ]]; then
        setsid -f fcitx5 -r -d >/dev/null 2>&1 || true
        echo "  fcitx5: frosted Catppuccin Sapphire skin, horizontal candidates (fcitx5 restarted for blur)"
    else
        echo "  fcitx5: frosted Catppuccin Sapphire skin, horizontal candidates (already active)"
    fi
elif [[ -f "$classicui" ]]; then
    python3 -I - "$classicui" <<'EOF'
import sys
path = sys.argv[1]
want = {"Vertical Candidate List": "False", "Theme": "catppuccin-latte-sapphire-frost",
        "DarkTheme": "catppuccin-mocha-sapphire-frost", "UseDarkTheme": "True"}
lines = open(path, encoding="utf-8").read().splitlines()
seen = set()
for i, line in enumerate(lines):
    key = line.split("=", 1)[0]
    if key in want:
        lines[i] = f"{key}={want[key]}"
        seen.add(key)
lines += [f"{k}={v}" for k, v in want.items() if k not in seen]
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
print("  fcitx5: frosted Catppuccin Sapphire skin, horizontal candidates (fcitx5 not running; file updated)")
EOF
fi

# Qt: the Profile uses Arch's qt6ct (rebuilt with every Qt release) instead
# of CatOS's qt6ct-kde, whose plugin was built for an older Qt and is then
# silently ignored, leaving every Qt app unthemed. Plain qt6ct cannot read
# KDE .colors files, so point it at the qt6ct palette DMS generates.
# qt6ct.conf is a seed; only color_scheme_path and custom_palette are touched.
qt6ct_conf="$HOME/.config/qt6ct/qt6ct.conf"
if [[ -f "$qt6ct_conf" ]]; then
    python3 -I - "$qt6ct_conf" <<'EOF'
import os, sys
path = sys.argv[1]
want = {"color_scheme_path": os.path.expanduser("~/.config/qt6ct/colors/matugen.conf"),
        "custom_palette": "true"}
lines = open(path, encoding="utf-8").read().splitlines()
seen = set()
for i, line in enumerate(lines):
    key = line.split("=", 1)[0]
    if key in want:
        lines[i] = f"{key}={want[key]}"
        seen.add(key)
missing = [f"{k}={v}" for k, v in want.items() if k not in seen]
if missing:
    at = lines.index("[Appearance]") + 1 if "[Appearance]" in lines else len(lines)
    lines[at:at] = missing
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
print("  qt6ct: DMS palette (qt6ct format)")
EOF
fi

# Firefox: Material Fox Updated (managed copy under ~/.local/share) styled
# with DMS's matugen colors (~/.config/DankMaterialShell/firefox.css). Profile
# directories have random names catdot cannot manage, so each profile gets a
# small chrome/userChrome.css + userContent.css that import the theme and
# then the DMS colors, plus the required prefs in a marked user.js block.
# A chrome/ directory this script did not write is left alone.
python3 -I - "$HOME" <<'EOF'
import configparser, os, sys
home = sys.argv[1]
theme = os.path.join(home, ".local/share/catos-niri-mistlake/firefox/chrome")
colors = os.path.join(home, ".config/DankMaterialShell/firefox.css")
if not os.path.isdir(theme):
    print("  firefox: theme files missing, skipped")
    sys.exit(0)
marker = "/* Managed by catos-niri-mistlake (mistlake-apply); edits are replaced. */"
def css(name):
    lines = [marker, f'@import url("file://{theme}/{name}");']
    if os.path.exists(colors):
        lines.append(f'@import url("file://{colors}");')
    return "\n".join(lines) + "\n"
begin, end = "// >>> mistlake", "// <<< mistlake"
prefs = "\n".join([begin,
    'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);',
    'user_pref("svg.context-properties.content.enabled", true);',
    'user_pref("layout.css.color-mix.enabled", true);',
    'user_pref("userChrome.theme-material", true);',
    end]) + "\n"
done, skipped = [], []
for root in (".config/mozilla/firefox", ".mozilla/firefox"):
    base = os.path.join(home, root)
    ini = os.path.join(base, "profiles.ini")
    if not os.path.exists(ini):
        continue
    cp = configparser.ConfigParser()
    cp.read(ini)
    for sec in cp.sections():
        if not sec.startswith("Profile") or "Path" not in cp[sec]:
            continue
        rel = cp[sec].get("IsRelative", "1") == "1"
        prof = os.path.join(base, cp[sec]["Path"]) if rel else cp[sec]["Path"]
        if not os.path.isdir(prof):
            continue
        chrome = os.path.join(prof, "chrome")
        uc = os.path.join(chrome, "userChrome.css")
        if os.path.isdir(chrome) and os.listdir(chrome) and not (
                os.path.exists(uc) and open(uc, encoding="utf-8").readline().strip() == marker):
            skipped.append(cp[sec]["Path"])
            continue
        os.makedirs(chrome, exist_ok=True)
        for name in ("userChrome.css", "userContent.css"):
            open(os.path.join(chrome, name), "w", encoding="utf-8").write(css(name))
        ujs = os.path.join(prof, "user.js")
        text = open(ujs, encoding="utf-8").read() if os.path.exists(ujs) else ""
        if begin in text and end in text:
            text = text[:text.index(begin)] + prefs + text[text.index(end) + len(end):].lstrip("\n")
        else:
            text = text.rstrip("\n") + ("\n\n" if text else "") + prefs
        open(ujs, "w", encoding="utf-8").write(text)
        done.append(cp[sec]["Path"])
msg = f"  firefox: Material Fox + DMS colors in {len(done)} profile(s)"
if skipped:
    msg += f"; skipped (own chrome/): {', '.join(skipped)}"
print(msg + ("; restart Firefox to apply" if done else ""))
EOF

# Cursor: niri (~/.icons/default), GTK settings.ini and XCURSOR_THEME already
# use Bibata-Modern-Ice, but the gsettings key read by GTK4/libadwaita apps
# and portal dialogs defaulted to Adwaita, so the cursor changed style
# between windows. Keep every source on the same theme and size.
# XCURSOR_THEME may be "default" (the ~/.icons/default alias), which GTK4
# does not resolve through Inherits=, so prefer the real name from GTK's
# settings.ini and never write "default".
if command -v gsettings >/dev/null 2>&1; then
    cursor=$(sed -n 's/^gtk-cursor-theme-name=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | head -n1)
    [[ -z "$cursor" || "$cursor" == default ]] && cursor=${XCURSOR_THEME:-}
    [[ -z "$cursor" || "$cursor" == default ]] && cursor=Bibata-Modern-Ice
    size=$(sed -n 's/^gtk-cursor-theme-size=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | head -n1)
    size=${size:-${XCURSOR_SIZE:-24}}
    gsettings set org.gnome.desktop.interface cursor-theme "$cursor"
    gsettings set org.gnome.desktop.interface cursor-size "$size"
    echo "  cursor: $cursor ${size}px everywhere"
fi

# Restart so DMS reloads settings.json. DMS reads theme.json asynchronously
# and its startup generation can run before the palette has loaded, leaving
# the old colors in niri, GTK, Qt and the terminals; re-asserting the current
# color mode once DMS is back forces a full regeneration.
dms restart >/dev/null 2>&1 || true
for _ in $(seq 1 30); do
    sleep 0.5
    dms ipc call theme getMode >/dev/null 2>&1 && break
done
sleep 2
mode=$(dms ipc call theme getMode 2>/dev/null | tr -d '"[:space:]')
case "$mode" in
    light) dms ipc call theme light >/dev/null ;;
    *)     dms ipc call theme dark >/dev/null ;;
esac
echo "DMS restarted and colors regenerated (${mode:-dark} mode)."
