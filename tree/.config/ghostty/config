# Font Configuration
# Maple Mono: rounded, calm letterforms; CJK falls back to Noto Sans Mono CJK.
font-family = "Maple Mono NF"
font-family = "Noto Sans Mono CJK SC"
font-size = 12
adjust-cell-height = 12%

# Window Configuration
window-decoration = false
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
# A thin veil of the wallpaper behind the text, like looking through mist.
background-opacity = 0.94
background-blur-radius = 32

# Cursor Configuration
cursor-style = bar
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable in-app Ghostty toast notifications
app-notifications = false

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.75
unfocused-split-fill = #0d1417

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dank color generation
theme = dankcolors
