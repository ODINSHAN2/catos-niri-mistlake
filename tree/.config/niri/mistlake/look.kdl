// Mistlake look. Loaded after catos/ and before dms/, so it overrides the CatOS
// baseline while DMS still owns colors, gaps and corner radius (set through
// DMS settings by mistlake-apply).
layout {
    // Fallback spacing for when DMS has not written dms/layout.kdl yet.
    gaps 10

    focus-ring {
        width 2
    }

    // A long, low shadow reads as depth through mist rather than a hard drop.
    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=10
        color "#00000066"
        inactive-color "#00000033"
    }
}

overview {
    // Deepest Mistlake surface, so the overview looks like the lake at night.
    backdrop-color "#0a1013"
    workspace-shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

// Background blur (niri 26.04+). Slightly larger and calmer than the default
// so translucent windows read as frosted mist rather than glass.
blur {
    passes 3
    offset 4.0
    noise 0.03
    saturation 1.3
}

// Ask for blur behind every window. Only translucent surfaces show it (GTK via
// mistlake.css, ghostty, and apps that request it themselves); xray stays on,
// so the blur is of the wallpaper and is computed once for all windows.
window-rule {
    background-effect {
        blur true
    }
}

// fuzzel draws a translucent panel; blur behind it too.
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
}

// Electron and Firefox windows paint their own opaque backgrounds, so the blur
// above never shows through them. Fade the whole window a little instead:
// text stays sharp at these levels and the frost appears behind it.
window-rule {
    match app-id=r#"^com\.anthropic\.Claude$"#
    match app-id=r#"^QQ$"#
    match app-id=r#"^firefox$"#
    match app-id=r#"^code(-oss)?$"#
    match app-id=r#"^(chromium|google-chrome|brave-browser)$"#
    opacity 0.94
}

window-rule {
    match app-id=r#"^com\.anthropic\.Claude$"# is-active=false
    match app-id=r#"^QQ$"# is-active=false
    match app-id=r#"^firefox$"# is-active=false
    match app-id=r#"^code(-oss)?$"# is-active=false
    match app-id=r#"^(chromium|google-chrome|brave-browser)$"# is-active=false
    opacity 0.88
}

// Fullscreen video and games should never be see-through.
window-rule {
    match app-id=r#"^(mpv|celluloid|io\.github\.celluloid_player\.Celluloid)$"#
    match app-id=r#"^steam_app_"#
    opacity 1.0
}
