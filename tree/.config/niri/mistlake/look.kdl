// Mistlake look. Loaded after catos/ and before dms/, so it overrides the CatOS
// baseline while DMS still owns colors, gaps and corner radius (set through
// DMS settings by mistlake-apply).
layout {
    // Fallback spacing for when DMS has not written dms/layout.kdl yet.
    gaps 10

    focus-ring {
        width 2
    }

    // A long, low shadow reads as depth through mist rather than a hard drop.
    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=10
        color "#00000066"
        inactive-color "#00000033"
    }
}

overview {
    // Deepest Mistlake surface, so the overview looks like the lake at night.
    backdrop-color "#0a1013"
    workspace-shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}
